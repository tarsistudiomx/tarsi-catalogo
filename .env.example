# Usar credenciales del ambiente indicado.
SKYDROPX_ENV=sandbox
SKYDROPX_CLIENT_ID=
SKYDROPX_CLIENT_SECRET=
TARSI_ORIGIN_CP=76099
TARSI_ORIGIN_COLONY="Plazas del Sol 2a Sección"

# Origen HTTPS de la tienda del ambiente. Para pruebas locales se admite localhost.
TARSI_SITE_URL=
# Generar un secreto aleatorio de al menos 32 caracteres, exclusivo del ambiente.
TARSI_QUOTE_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TARSI_ENABLE_LIVE_PAYMENTS=false
